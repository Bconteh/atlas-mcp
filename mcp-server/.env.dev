# ─── Development Environment ───────────────────────────────────────────────────
APP_ENV=dev
ENVIRONMENT=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Atlas API (mock in dev)
ATLAS_API_BASE_URL=https://atlas-api.dev.example.com
ATLAS_API_KEY=mock-api-key-dev
ATLAS_USE_MOCK=true

# LLM Configuration
# Supports OpenAI, Azure OpenAI, GitHub Copilot (openai-compatible)
LLM_API_KEY=your-openai-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Azure OpenAI (uncomment and fill in to use Azure instead)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

