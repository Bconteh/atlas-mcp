# ─── User Integration Test (UIT) Environment ───────────────────────────────────
APP_ENV=uit
ENVIRONMENT=uit
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Atlas API (mock in UIT – set ATLAS_USE_MOCK=false when connecting to real UIT Atlas)
ATLAS_API_BASE_URL=https://atlas-api.uit.example.com
ATLAS_API_KEY=uit-atlas-api-key-here
ATLAS_USE_MOCK=true

# LLM Configuration
LLM_API_KEY=your-openai-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Azure OpenAI (uncomment to use)
# AZURE_OPENAI_ENDPOINT=https://your-uit-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# CORS
CORS_ORIGINS=https://atlas-mcp-ui.uit.example.com,http://localhost:5173

