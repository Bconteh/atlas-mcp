# ─── Production Environment ────────────────────────────────────────────────────
APP_ENV=prod
ENVIRONMENT=prod
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Atlas API (REAL API in prod – set ATLAS_USE_MOCK=false)
ATLAS_API_BASE_URL=https://atlas-api.prod.example.com
ATLAS_API_KEY=prod-atlas-api-key-here
ATLAS_USE_MOCK=false

# LLM Configuration
LLM_API_KEY=your-prod-openai-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# Azure OpenAI (uncomment to use)
# AZURE_OPENAI_ENDPOINT=https://your-prod-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01

# CORS (restrict to known production origins)
CORS_ORIGINS=https://atlas-mcp-ui.prod.example.com

