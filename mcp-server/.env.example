# ─── Environment Template ──────────────────────────────────────────────────────
# Copy to .env.dev / .env.uit / .env.prod and fill in the values.

APP_ENV=dev           # dev | uit | prod
DEBUG=true
HOST=0.0.0.0
PORT=8000

ATLAS_API_BASE_URL=https://atlas-api.ENVIRONMENT.example.com
ATLAS_API_KEY=your-atlas-api-key
ATLAS_USE_MOCK=true   # Set to false to call the real Atlas API

# One of: OpenAI, Azure OpenAI, GitHub Copilot (openai-compatible base_url)
LLM_API_KEY=your-llm-api-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Azure OpenAI (optional)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-02-01

CORS_ORIGINS=http://localhost:5173

